{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/dist/index.html" },
    { "source": "/styles.css", "destination": "/dist/styles.css" },
    { "source": "/refinement.css", "destination": "/dist/refinement.css" },
    { "source": "/data.js", "destination": "/dist/data.js" },
    { "source": "/app.js", "destination": "/dist/app.js" },
    { "source": "/assets/:path*", "destination": "/dist/assets/:path*" }
  ]
}
